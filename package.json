{
  "name": "legion-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/types",
    "packages/core",
    "packages/runtime",
    "packages/web",
    "packages/e2e"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:integration": "LEGION_INTEGRATION=1 LEGION_MCP_INTEGRATION=1 vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:integration": "LEGION_INTEGRATION=1 LEGION_MCP_INTEGRATION=1 vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force && tsc -p packages/types/tsconfig.type-tests.json",
    "start": "node packages/runtime/bin/legion.js",
    "dev": "tsx watch --tsconfig tsconfig.dev.json --exclude '**/*.timestamp-*.mjs' packages/runtime/bin/legion.js --dev",
    "test:e2e": "playwright test --config packages/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0"
  }
}
